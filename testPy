from fastapi import FastAPI, HTTPException
from pydantic import BaseModel
import json
import requests
import re

app = FastAPI()

# Load Postman collection once
with open("postman_collection.json") as f:
    postman_collection = json.load(f)

# Request model
class RequestModel(BaseModel):
    env: str
    uri: str
    payload: dict = {}

# Helper to match uri with path in Postman
def match_uri(uri, path_segments):
    postman_path = "/" + "/".join(path_segments)
    # Replace :id with regex match
    regex = re.sub(r":\w+", r"[^/]+", postman_path)
    return re.match(f"^{regex}$", uri)

# Extract path variable values if needed (not strictly required for this logic)
def extract_path_vars(path_segments, actual_uri):
    uri_parts = actual_uri.strip("/").split("/")
    path_parts = path_segments
    return {
        seg[1:]: val
        for seg, val in zip(path_parts, uri_parts)
        if seg.startswith(":")
    }

@app.post("/run")
def run_postman_request(req: RequestModel):
    for item in postman_collection.get("item", []):
        request = item.get("request", {})
        url = request.get("url", {})
        host = url.get("host", [])
        path = url.get("path", [])
        
        if not host or not path:
            continue

        # Match env with host[0]
        if host[0] != req.env:
            continue

        # Match the URI with path list
        if not match_uri(req.uri, path):
            continue

        # Matched request found
        method = request.get("method", "GET").upper()
        raw_url = url.get("raw")
        headers = {h["key"]: h["value"] for h in request.get("header", [])}

        try:
            response = requests.request(
                method=method,
                url=raw_url,
                headers=headers,
                json=req.payload if method in ("POST", "PUT", "PATCH") else None
            )
            return {
                "status_code": response.status_code,
                "headers": dict(response.headers),
                "response": response.json() if "application/json" in response.headers.get("Content-Type", "") else response.text
            }
        except Exception as e:
            raise HTTPException(status_code=500, detail=str(e))

    raise HTTPException(status_code=404, detail="No matching request found in Postman collection")
