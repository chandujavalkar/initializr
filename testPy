import urllib3
from fastapi import FastAPI, HTTPException
from pydantic import BaseModel
import json
import re
from uuid import uuid4
from datetime import datetime, timezone

app = FastAPI()

# Load Postman collection once
with open("postman_collection.json") as f:
    postman_collection = json.load(f)

class RequestModel(BaseModel):
    env: str
    uri: str
    payload: dict = {}

import os
import json

def load_first_postman_collection():
    folder = "postman_collections"
    for fname in os.listdir(folder):
        if fname.endswith(".json"):
            full_path = os.path.join(folder, fname)
            try:
                with open(full_path) as f:
                    data = json.load(f)
                print(f"[INFO] ✅ Loaded Postman collection: {fname}")
                if "item" not in data:
                    raise ValueError("Invalid Postman collection: missing 'item' key")
                print(f"[INFO] Collection contains {len(data['item'])} top-level items.")
                return data
            except json.JSONDecodeError as e:
                print(f"[WARN] Skipping file {fname}: invalid JSON - {e}")
    raise FileNotFoundError("No valid Postman collection JSON found in postman_collections/ folder.")

def resolve_postman_variables(value: str) -> str:
    if "{{$guid}}" in value:
        value = value.replace("{{$guid}}", str(uuid4()))
    if "{{$isoTimestamp}}" in value:
        iso_time = datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")
        value = value.replace("{{$isoTimestamp}}", iso_time)
    return value

def match_uri(uri, path_segments):
    postman_path = "/" + "/".join(path_segments)
    regex = re.sub(r":\w+", r"[^/]+", postman_path)
    print(f"[DEBUG] URI: {uri} | Path: {postman_path} | Regex: ^{regex}$")
    return re.match(f"^{regex}$", uri)

def extract_requests(items):
    requests = []
    for item in items:
        if "request" in item:
            requests.append(item)
        elif "item" in item:
            requests.extend(extract_requests(item["item"]))
    return requests

def build_ssl_context(env: str) -> ssl.SSLContext:
    cert_dir = os.path.join("certs", env)
    crt_path = os.path.join(cert_dir, "client.crt")
    key_path = os.path.join(cert_dir, "client.key")
    pass_path = os.path.join(cert_dir, "passphrase.txt")

    if not os.path.exists(crt_path) or not os.path.exists(key_path):
        raise FileNotFoundError(f"Missing cert or key file for env: {env}")

    if not os.path.exists(pass_path):
        raise FileNotFoundError(f"Missing passphrase.txt for env: {env}")

    with open(pass_path) as f:
        passphrase = f.read().strip()

    context = ssl.create_default_context()
    context.load_cert_chain(certfile=crt_path, keyfile=key_path, password=passphrase)

    return context
@app.post("/run")
def run_postman_request(req: RequestModel):
    all_requests = extract_requests(postman_collection.get("item", []))

    for item in all_requests:
        request = item.get("request", {})
        url = request.get("url", {})
        host = url.get("host", [])
        path = url.get("path", [])

        if not host or not path:
            continue

        if req.env not in host[0]:
            continue

        if not match_uri(req.uri, path):
            continue

        method = request.get("method", "GET").upper()
        raw_url = url.get("raw")
        headers = {
            h["key"]: resolve_postman_variables(h["value"])
            for h in request.get("header", [])
        }

        # ✅ Build SSL context for client cert with passphrase
        try:
            ssl_context = build_ssl_context(req.env)
            http = urllib3.PoolManager(ssl_context=ssl_context)
        except Exception as e:
            raise HTTPException(500, detail=f"Error loading certs: {e}")

        try:
            encoded_body = None
            if method in ("POST", "PUT", "PATCH") and req.payload:
                import json as jsonlib
                encoded_body = jsonlib.dumps(req.payload).encode("utf-8")
                headers["Content-Type"] = "application/json"

            r = http.request(
                method=method,
                url=raw_url,
                headers=headers,
                body=encoded_body,
                retries=False,
            )

            # Try to decode JSON response, else return text
            try:
                response_data = json.loads(r.data.decode("utf-8"))
            except:
                response_data = r.data.decode("utf-8")

            return {
                "status_code": r.status,
                "headers": dict(r.headers),
                "response": response_data
            }

        except Exception as e:
            raise HTTPException(500, detail=f"HTTP request failed: {e}")

    raise HTTPException(404, detail="No matching request found in Postman collection")
