SELECT
    ua.ACCOUNT_NO,
    ua.COMPANY_ID,
    ua.HOGAN_PRODUCT_CD,
    ua.SUBPRODUCT_CODE,
    ua.ACCOUNT_ID,

    COUNT(DISTINCT ua.ACCOUNT_ID)
        OVER (PARTITION BY ua.USER_ID) AS DISTINCT_ACCOUNT_ID_COUNT,

    ua.ACCOUNT_STATUS,

    uas.USER_ID,

    uas.MESSAGE_TYPE_ID,

    CASE
        WHEN uas.ACTIVE_IND = 'Y' THEN 'Y'
        ELSE 'N'
    END AS SUBSCRIPTION_IND,

    ua.PMC_IND,

    ua.PRODUCT_CODE,

    ua.PREFERRED_LANGUAGE,

    ua.XA_ID,

    ua.ECN,

    uasp.SUBSCRIPTION_PARAMETER_ID,

    uasp.PARAMETER_VALUE,

    uasp.CREATOR_ID,

    uasp.CREATE_DATE,

    uasp.MODIFIER_ID,

    uasp.MODIFY_DATE,

    sp.PARAMETER_NAME,

    sp.PARAMETER_DESC,

    sp.PARAMETER_DATATYPE

FROM ANG.T_USER_ACCOUNT ua

JOIN ANG.T_USER_ACCOUNT_SUB uas
    ON ua.ACCOUNT_ID = uas.ACCOUNT_ID
   AND ua.USER_ID    = uas.USER_ID

JOIN ANG.T_MESSAGE_TYPE mt
    ON mt.MESSAGE_TYPE_ID = uas.MESSAGE_TYPE_ID

LEFT JOIN ANG.T_USER_ACCOUNT_SUB_PARAMETER uasp
    ON uasp.ACCOUNT_ID      = uas.ACCOUNT_ID
   AND uasp.USER_ID         = uas.USER_ID
   AND uasp.MESSAGE_TYPE_ID = uas.MESSAGE_TYPE_ID

LEFT JOIN ANG.T_SUB_PARAMETER sp
    ON sp.SUBSCRIPTION_PARAMETER_ID =
       uasp.SUBSCRIPTION_PARAMETER_ID

WHERE
      ua.ACCOUNT_STATUS = 'ACTIVE'
  AND uas.ACTIVE_IND = 'Y';
